apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: movie-reviews-tracker
spec:
  project: default
  source:
    repoURL: https://github.com/MaelDieudonne/MLOps.git
    targetRevision: main
    path: deployment
  destination:
    server: https://kubernetes.default.svc
    namespace: user-maeldieudonne
  syncPolicy:
    automated:
      selfHeal: true